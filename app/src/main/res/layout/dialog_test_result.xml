<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="All checks passed successfully!"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="We are sending you a test notification now. Did you receive it?"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnYes"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Yes, Notification received" />

    <Button
        android:id="@+id/btnSound"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="But I have sound issues"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnNo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Did not receive!"
        android:textColor="@color/error"
        android:layout_marginTop="8dp" />
</LinearLayout>


