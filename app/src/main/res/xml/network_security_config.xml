<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext traffic for development/local testing -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Local development servers -->
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        
        <!-- Add your local network IP addresses -->
        <domain includeSubdomains="true">192.168.1.191</domain>
        <domain includeSubdomains="true">192.168.1.195</domain>
        <domain includeSubdomains="true">192.168.1.198</domain>
        
        <!-- Add any other local IPs you use for development -->
        <!-- Example: <domain includeSubdomains="true">192.168.0.100</domain> -->
    </domain-config>
    
    <!-- Production configuration - only HTTPS allowed -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
